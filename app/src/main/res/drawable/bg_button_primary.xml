<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="3dp"
        android:top="5dp"
        android:right="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#5520D8FF" />
        </shape>
    </item>
    <item android:bottom="5dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="0"
                android:startColor="#1288FF"
                android:endColor="#1DE1F2" />
            <stroke
                android:width="1dp"
                android:color="#7AEEFF" />
        </shape>
    </item>
</layer-list>
