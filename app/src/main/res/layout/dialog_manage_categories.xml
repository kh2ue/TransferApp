<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    android:padding="20dp"
    android:background="@color/colorBackground">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="إدارة الفئات والأسعار"
        android:textColor="@color/colorTextPrimary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <Spinner
        android:id="@+id/spinner_category_service"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_input_gray"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/input_category_amount"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_gray"
            android:hint="الرصيد / الكمية"
            android:inputType="number"
            android:paddingHorizontal="12dp"
            android:textColor="@color/colorTextPrimary"
            android:textColorHint="@color/colorHint"
            android:layout_marginEnd="8dp" />

        <EditText
            android:id="@+id/input_category_price"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_gray"
            android:hint="السعر"
            android:inputType="number"
            android:paddingHorizontal="12dp"
            android:textColor="@color/colorTextPrimary"
            android:textColorHint="@color/colorHint" />
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_category_add"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="إضافة فئة"
        android:textStyle="bold"
        android:background="@drawable/bg_rounded_orange"
        android:textColor="@color/colorTextOnPrimary"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_categories"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:clipToPadding="false"
        android:paddingBottom="4dp" />
</LinearLayout>
