<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:layout_marginHorizontal="2dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp" android:layoutDirection="rtl" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/tv_trans_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="اسم الزبون" android:textSize="18sp" android:textStyle="bold" android:textColor="#333333" />
            <TextView android:id="@+id/tv_trans_note" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ملاحظات" android:textSize="14sp" android:textColor="#777777" android:layout_marginTop="4dp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:id="@+id/tv_trans_type" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="دين" android:textSize="12sp" android:textStyle="bold" android:textColor="#D32F2F" />
            <TextView android:id="@+id/tv_trans_amount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5000" android:textSize="18sp" android:textStyle="bold" android:textColor="#D32F2F" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>