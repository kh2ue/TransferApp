<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/neon_glass_fill"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_neon_glass_card"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_company_log_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/neon_cyan_bright"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_company_log_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/neon_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_company_log_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/neon_cyan_bright"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_company_log_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/neon_cyan_bright"
            android:textSize="12sp" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
