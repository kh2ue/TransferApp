<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layoutDirection="rtl" android:padding="24dp" android:background="@color/colorBackground">
    <TextView android:id="@+id/tv_report_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="تقرير المبيعات" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/colorTextPrimary" android:layout_marginBottom="20dp" />
    <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_rep_from" android:layout_width="match_parent" android:layout_height="55dp" android:text="من تاريخ: غير محدد" android:background="@drawable/bg_input_gray" android:layout_marginBottom="12dp" android:gravity="start|center_vertical" android:paddingStart="16dp" android:textColor="@color/colorTextPrimary" />
    <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_rep_to" android:layout_width="match_parent" android:layout_height="55dp" android:text="إلى تاريخ: غير محدد" android:background="@drawable/bg_input_gray" android:layout_marginBottom="16dp" android:gravity="start|center_vertical" android:paddingStart="16dp" android:textColor="@color/colorTextPrimary" />
    <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_rep_calc" android:layout_width="match_parent" android:layout_height="55dp" android:text="حساب التقرير" android:textSize="16sp" android:textStyle="bold" android:background="@drawable/bg_rounded_orange" android:textColor="@color/colorTextOnPrimary" android:layout_marginBottom="20dp" />
    <LinearLayout android:id="@+id/layout_rep_results" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/colorDivider" android:layout_marginBottom="16dp" />
        <TextView android:id="@+id/tv_rep_credit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="إجمالي الرصيد المحول: 0" android:textColor="@color/colorSuccess" android:textSize="16sp" android:textStyle="bold" android:layout_marginBottom="8dp" />
        <TextView android:id="@+id/tv_rep_financial" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="إجمالي الدين المالي: 0" android:textColor="@color/colorDanger" android:textSize="16sp" android:textStyle="bold" android:layout_marginBottom="8dp" />
        <TextView android:id="@+id/tv_rep_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="عدد العمليات: 0" android:textColor="@color/colorTextSecondary" android:textSize="14sp" android:layout_marginBottom="8dp" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_rep_export_pdf" android:layout_width="match_parent" android:layout_height="55dp" android:text="تصدير السجل التفصيلي (PDF)" android:textSize="15sp" android:textStyle="bold" android:background="@drawable/bg_btn_outline" android:textColor="@color/colorPrimary" android:layout_marginBottom="20dp" />
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_rep_close" android:layout_width="match_parent" android:layout_height="55dp" android:text="إغلاق" android:textSize="16sp" android:textStyle="bold" android:background="@drawable/bg_btn_outline" android:textColor="@color/colorPrimary" android:layout_marginTop="8dp" />
</LinearLayout>