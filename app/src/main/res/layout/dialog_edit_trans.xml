<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layoutDirection="rtl" android:padding="24dp" android:background="#FFFFFF">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="تعديل الحركة المالية" android:textSize="20sp" android:textStyle="bold" android:textColor="#2C3E50" android:layout_marginBottom="16dp"/>
    <TextView android:id="@+id/tv_edit_trans_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="اسم الزبون" android:textSize="16sp" android:textStyle="bold" android:textColor="#888888" android:layout_marginBottom="8dp"/>
    <TextView android:id="@+id/tv_edit_trans_type_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="نوع الحركة" android:textSize="16sp" android:textStyle="bold" android:textColor="#D32F2F" android:layout_marginBottom="16dp"/>
    <EditText android:id="@+id/edit_trans_amount" android:layout_width="match_parent" android:layout_height="55dp" android:background="@drawable/bg_input_gray" android:inputType="number" android:hint="المبلغ" android:paddingStart="16dp" android:paddingEnd="16dp" android:textColor="#333333" android:layout_marginBottom="16dp"/>
    <EditText android:id="@+id/edit_trans_note" android:layout_width="match_parent" android:layout_height="55dp" android:background="@drawable/bg_input_gray" android:hint="ملاحظة" android:paddingStart="16dp" android:paddingEnd="16dp" android:textColor="#333333" android:layout_marginBottom="24dp"/>
    <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_update_trans" android:layout_width="match_parent" android:layout_height="55dp" android:text="حفظ التعديلات" android:textSize="18sp" android:textStyle="bold" android:background="@drawable/bg_rounded_orange" android:textColor="#FFFFFF" />
</LinearLayout>