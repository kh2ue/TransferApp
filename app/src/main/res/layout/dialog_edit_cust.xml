<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        style="@style/DialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="تعديل بيانات الزبون" />

    <EditText
        android:id="@+id/edit_cust_name"
        style="@style/AppField"
        android:layout_width="match_parent"
        android:layout_marginBottom="12dp"
        android:drawableStart="@drawable/ic_user"
        android:hint="اسم الزبون" />

    <EditText
        android:id="@+id/edit_cust_syr"
        style="@style/AppField"
        android:layout_width="match_parent"
        android:layout_marginBottom="12dp"
        android:hint="رقم Syriatel"
        android:inputType="phone" />

    <EditText
        android:id="@+id/edit_cust_mtn"
        style="@style/AppField"
        android:layout_width="match_parent"
        android:layout_marginBottom="12dp"
        android:hint="رقم MTN"
        android:inputType="phone" />

    <EditText
        android:id="@+id/input_initial_debt"
        style="@style/AppField"
        android:layout_width="match_parent"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_field"
        android:hint="الدين الابتدائي (الرصيد المطلوب منه مسبقاً)"
        android:inputType="numberDecimal" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_update_cust"
        style="@style/AppButton.Primary"
        android:layout_width="match_parent"
        android:text="حفظ التعديلات" />
</LinearLayout>
