<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    android:padding="24dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="إضافة دين جديد"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#2C3E50"
        android:layout_marginBottom="20dp"/>

    <EditText
        android:id="@+id/input_debt_name"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="@drawable/bg_input_gray"
        android:hint="اسم الزبون"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="#333333"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/input_debt_amount"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="@drawable/bg_input_gray"
        android:inputType="number"
        android:hint="المبلغ (مثال: 5000)"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="#333333"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/input_debt_note"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="@drawable/bg_input_gray"
        android:hint="ملاحظات (مثال: باقي حوالة...)"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="#333333"
        android:layout_marginBottom="24dp"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_confirm_debt"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="حفظ الدين"
        android:textSize="18sp"
        android:textStyle="bold"
        android:background="@drawable/bg_rounded_orange"
        android:textColor="#FFFFFF" />
</LinearLayout>