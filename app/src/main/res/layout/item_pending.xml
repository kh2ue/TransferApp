<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="6dp" android:layout_marginHorizontal="2dp" app:cardCornerRadius="12dp" app:cardElevation="1dp" app:cardBackgroundColor="#FFFFFF">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp" android:layoutDirection="rtl" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/tv_pend_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="اسم الزبون" android:textSize="18sp" android:textStyle="bold" android:textColor="#333333" />
            <TextView android:id="@+id/tv_pend_details" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="التفاصيل" android:textSize="14sp" android:textColor="#FF6B00" android:layout_marginTop="4dp"/>
            <TextView android:id="@+id/tv_pend_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="التاريخ" android:textSize="11sp" android:textColor="#AAAAAA" android:layout_marginTop="4dp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_pend_execute" android:layout_width="70dp" android:layout_height="40dp" android:text="تنفيذ" android:textSize="12sp" android:textStyle="bold" android:background="@drawable/bg_rounded_orange" android:textColor="#FFFFFF" />
            <TextView android:id="@+id/btn_pend_delete" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="حذف" android:textSize="14sp" android:textColor="#F44336" android:padding="8dp" android:layout_marginTop="4dp"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>