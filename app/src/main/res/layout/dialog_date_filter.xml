<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tv_dialog_title"
        style="@style/DialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="فلترة حسب التاريخ" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_pick_from"
        style="@style/AppButton.Outline"
        android:layout_width="match_parent"
        android:layout_marginBottom="12dp"
        android:text="من تاريخ: غير محدد" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_pick_to"
        style="@style/AppButton.Outline"
        android:layout_width="match_parent"
        android:layout_marginBottom="16dp"
        android:text="إلى تاريخ: غير محدد" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="rtl"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_apply_dates"
            style="@style/AppButton.Primary"
            android:layout_width="0dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="متابعة" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_clear_dates"
            style="@style/AppButton.Outline"
            android:layout_width="0dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="بدون فلتر" />
    </LinearLayout>
</LinearLayout>
