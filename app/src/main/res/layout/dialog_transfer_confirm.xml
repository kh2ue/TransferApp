<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        style="@style/DialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="تأكيد الحوالة" />

    <TextView
        android:id="@+id/tv_confirm_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:textColor="@color/text_primary"
        android:textSize="16sp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_confirm_yes"
        style="@style/AppButton.Primary"
        android:layout_width="match_parent"
        android:layout_marginBottom="12dp"
        android:text="تم التحويل" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_confirm_later"
        style="@style/AppButton.Outline"
        android:layout_width="match_parent"
        android:layout_marginBottom="12dp"
        android:drawableEnd="@drawable/ic_clock"
        android:text="حفظ في المعلقات" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_confirm_cancel"
        style="@style/AppButton.Danger"
        android:layout_width="match_parent"
        android:text="إلغاء الطلب" />
</LinearLayout>
