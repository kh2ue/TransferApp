<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:layoutDirection="rtl" android:padding="24dp" android:background="#FFFFFF">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="تأكيد الحوالة" android:textSize="20sp" android:textStyle="bold" android:textColor="#2C3E50" android:layout_marginBottom="16dp"/>

    <TextView android:id="@+id/tv_confirm_message" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="هل تمت الحوالة بنجاح؟" android:textSize="16sp" android:textColor="#333333" android:layout_marginBottom="24dp"/>

    <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_confirm_yes" android:layout_width="match_parent" android:layout_height="55dp" android:text="نعم" android:textSize="16sp" android:textStyle="bold" android:background="#4CAF50" android:textColor="#FFFFFF" android:layout_marginBottom="16dp"/>

    <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_confirm_later" android:layout_width="match_parent" android:layout_height="55dp" android:text="التحويل لاحقا" android:textSize="16sp" android:textStyle="bold" android:background="#FF9800" android:textColor="#FFFFFF" android:layout_marginBottom="16dp"/>

    <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_confirm_cancel" android:layout_width="match_parent" android:layout_height="55dp" android:text="الغاء الطلب" android:textSize="16sp" android:textStyle="bold" android:background="#F44336" android:textColor="#FFFFFF" />

</LinearLayout>