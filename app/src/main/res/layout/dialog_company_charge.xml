<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tv_charge_title"
        style="@style/DialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="شحن رصيد للشركة" />

    <EditText
        android:id="@+id/input_charge_amount"
        style="@style/AppField"
        android:layout_width="match_parent"
        android:layout_marginBottom="12dp"
        android:drawableStart="@drawable/ic_wallet"
        android:hint="كمية الرصيد المضاف"
        android:inputType="number" />

    <EditText
        android:id="@+id/input_charge_note"
        style="@style/AppField"
        android:layout_width="match_parent"
        android:layout_marginBottom="16dp"
        android:hint="ملاحظة" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_save_charge"
        style="@style/AppButton.Primary"
        android:layout_width="match_parent"
        android:text="حفظ الشحن" />
</LinearLayout>
