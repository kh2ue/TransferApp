                            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_filter_date" android:layout_width="wrap_content" android:layout_height="55dp" android:text="تاريخ" android:textSize="14sp" android:textStyle="bold" android:background="@drawable/bg_neon_button_outline" android:textColor="@color/neon_cyan_bright" android:paddingHorizontal="16dp" />
