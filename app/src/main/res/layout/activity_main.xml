<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:layoutDirection="rtl" android:background="@drawable/bg_screen">
    <eightbitlab.com.blurview.BlurView android:id="@+id/header_blur_view" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_marginTop="10dp" android:layout_marginEnd="10dp" android:background="@drawable/bg_header" android:outlineProvider="background" android:clipToOutline="true" app:blurOverlayColor="@color/transparent">
