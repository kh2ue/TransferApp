                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <EditText android:id="@+id/input_cust_name" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_neon_input" android:hint="اسم الزبون" android:paddingHorizontal="16dp" android:textSize="16sp" android:textColor="@color/colorTextPrimary" android:textColorHint="@color/neon_cyan_bright" android:gravity="right|center_vertical" android:textDirection="rtl" />
