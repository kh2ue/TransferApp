                </LinearLayout>
                <EditText style="@style/AppField" android:id="@+id/input_search_cust" android:layout_width="match_parent" android:hint="اكتب للبحث..." android:drawableStart="@drawable/ic_search" android:layout_marginBottom="16dp" android:visibility="gone" />
