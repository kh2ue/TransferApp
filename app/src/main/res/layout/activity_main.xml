                            <EditText style="@style/AppField" android:id="@+id/input_trans_amount" android:layout_width="0dp" android:layout_weight="1" android:inputType="number" android:hint="المبلغ المستلم" android:drawableStart="@drawable/ic_wallet" android:layout_marginEnd="8dp" />
                            <EditText style="@style/AppField" android:id="@+id/input_trans_note" android:layout_width="0dp" android:layout_weight="1" android:hint="ملاحظة" />
