                            <EditText style="@style/FieldText" android:id="@+id/input_transfer_price" android:layout_width="0dp" android:layout_weight="1" android:layout_height="58dp" android:background="@drawable/bg_field" android:drawableStart="@drawable/ic_tag" android:drawablePadding="10dp" android:inputType="number" android:hint="@string/price" android:paddingStart="12dp" android:paddingEnd="12dp" android:textColorHint="@color/text_secondary" android:textStyle="bold" android:gravity="right|center_vertical" android:textDirection="rtl" />
