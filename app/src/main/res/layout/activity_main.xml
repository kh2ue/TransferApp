                    <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                    <ImageView android:id="@+id/btn_toggle_search_trans" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_search" android:padding="12dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="بحث" />
