<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:layout_marginHorizontal="2dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="#FFFFFF">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp" android:layoutDirection="rtl" android:gravity="center_vertical">
        <androidx.cardview.widget.CardView android:layout_width="40dp" android:layout_height="40dp" app:cardCornerRadius="20dp" app:cardBackgroundColor="#FFF0E6" app:cardElevation="0dp">
            <TextView android:id="@+id/tv_initial" android:layout_width="match_parent" android:layout_height="match_parent" android:text="ز" android:textSize="18sp" android:textStyle="bold" android:textColor="#FF6B00" android:gravity="center" />
        </androidx.cardview.widget.CardView>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:orientation="vertical">
            <TextView android:id="@+id/tv_customer_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="اسم الزبون" android:textSize="18sp" android:textStyle="bold" android:textColor="#333333" />
            <TextView android:id="@+id/tv_syriatel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Syr: -" android:textSize="14sp" android:textColor="#D32F2F" android:layout_marginTop="4dp"/>
            <TextView android:id="@+id/tv_mtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MTN: -" android:textSize="14sp" android:textColor="#FBC02D" android:layout_marginTop="2dp"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>